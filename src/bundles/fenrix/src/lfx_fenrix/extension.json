{
  "$schema": "https://schemas.langflow.org/extension/v1.json",
  "id": "lfx-fenrix",
  "version": "0.2.0",
  "name": "Fenrix",
  "description": "FenrixCloud platform glue: a pre-configured Ollama model provider and components for the rest of the platform (e.g. LibreChat memories).",
  "lfx": { "compat": ["1"] },
  "bundles": [
    {
      "name": "fenrix",
      "path": "components/fenrix"
    }
  ],
  "providers": [
    {
      "name": "Fenrix",
      "metadata": {
        "icon": "Ollama",
        "max_tokens_field_name": "max_tokens",
        "variables": [
          {
            "variable_name": "Fenrix Ollama Base URL",
            "variable_key": "OLLAMA_BASE_URL",
            "required": true,
            "is_secret": false,
            "is_list": false,
            "options": [],
            "langchain_param": "base_url",
            "component_metadata": {
              "mapping_field": "ollama_base_url",
              "required": false,
              "advanced": true,
              "info": "FenrixCloud's shared Ollama server. Pre-configured automatically at login - no manual entry needed."
            }
          }
        ],
        "api_docs_url": "https://ollama.com/",
        "mapping": { "model_class": "ChatOllama", "model_param": "model" }
      },
      "api_key_required": false,
      "live": true,
      "live_discovery": "lfx_fenrix.discovery:fetch_live_fenrix_models",
      "validator": "lfx_fenrix.discovery:validate_fenrix_credentials"
    }
  ]
}
